# Copy to .env. Placeholders only; never commit real secrets.
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot_dev_password
POSTGRES_DB=opspilot
DATABASE_URL=postgresql+psycopg://opspilot:opspilot_dev_password@postgres:5432/opspilot
REDIS_URL=redis://redis:6379/0
OPSPILOT_ENV=dev
OPSPILOT_LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OPSPILOT_ACTIONS_ENABLED=false
NEXT_PUBLIC_API_URL=http://localhost:8000
OPSPILOT_INGEST_TOKEN=dev-ingest-token
TELEMETRY_RETENTION_DAYS=7
DETECTION_RECOVERY_MINUTES=10

# Investigations need an LLM key; without one they fail as retryable and detection still works.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Read-only GitHub access (fine-grained token: Contents, Metadata, Actions = read).
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=

# Approvals and the PR executor. Actions stay off unless OPSPILOT_ACTIONS_ENABLED=true.
OPSPILOT_APPROVER_TOKEN=
# Optional: require this bearer token for read APIs (dashboard sends it server-side)
OPSPILOT_VIEWER_TOKEN=
GITHUB_WRITE_TOKEN=
