# Copy to .env on the server and fill in. Generate secrets with: openssl rand -hex 24
DASH_DOMAIN=opspilot.example.com
API_DOMAIN=api.opspilot.example.com
DASH_USER=admin
# caddy hash-password output with every "$" doubled to "$$" (compose treats a single "$" as a variable)
DASH_PASSWORD_HASH=

POSTGRES_PASSWORD=
OPSPILOT_INGEST_TOKEN=
OPSPILOT_VIEWER_TOKEN=
OPSPILOT_APPROVER_TOKEN=

# auto = LLM if ANTHROPIC_API_KEY is set, else the built-in rule-based investigator
OPSPILOT_INVESTIGATOR=auto
ANTHROPIC_API_KEY=
# Actions stay off until you deliberately enable the PR executor
OPSPILOT_ACTIONS_ENABLED=false
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=
GITHUB_WRITE_TOKEN=
TELEMETRY_RETENTION_DAYS=7
